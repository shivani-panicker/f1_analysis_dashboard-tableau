    <worksheet name='yoy driver performance'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='master (F1_Analysis)' name='federated.16com6h1t3jbmr1diqv9d1h73lmh' />
          </datasources>
          <datasource-dependencies datasource='federated.16com6h1t3jbmr1diqv9d1h73lmh'>
            <column caption='YoY Points Change' datatype='integer' name='[Calculation_0563545215832065]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([points]) - LOOKUP(SUM([points]), -1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='YoY Indicator' datatype='string' name='[Calculation_0563545221267458]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_0563545215832065] &gt; 0 THEN &quot;▲ +&quot;&#13;&#10;ELSEIF [Calculation_0563545215832065] &lt; 0 THEN &quot;▼&quot;&#13;&#10;ELSE &quot;►&quot;&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Yoy Points Change % ' datatype='real' name='[Calculation_0563545230434307]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([points]) / LOOKUP(SUM([points]), -1)) - 1'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Driver Name' datatype='string' name='[driverName]' role='dimension' type='nominal' />
            <column-instance column='[driverName]' derivation='None' name='[none:driverName:nk]' pivot='key' type='nominal' />
